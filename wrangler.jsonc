// Static site served by Workers static assets; only public/ is published.
{
  "name": "deluispablo",
  "compatibility_date": "2026-08-22",
  "assets": { "directory": "./public" },
  "routes": [
    { "pattern": "deluispablo.com", "custom_domain": true },
    { "pattern": "www.deluispablo.com", "custom_domain": true }
  ]
}
